{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "node"],
    "noEmit": true,
    "paths": {
      "@tc96/utils": ["./packages/utils/src/index.ts"],
      "@tc96/themes": ["./packages/themes/src/index.ts"],
      "@tc96/ui/patterns": ["./packages/ui/src/patterns/index.ts"],
      "@tc96/ui/patterns/*": ["./packages/ui/src/patterns/*"],
      "@tc96/ui/blocks/*": ["./packages/ui/src/blocks/*"],
      "@tc96/ui/helpers/*": ["./packages/ui/src/helpers/*"],
      "@tc96/ui/hooks/*": ["./packages/ui/src/hooks/*"],
      "@tc96/ui/lib/*": ["./packages/ui/src/lib/*"],
      "@tc96/ui/*": ["./packages/ui/src/components/*"]
    }
  },
  "exclude": ["**/node_modules", "**/dist"]
}
