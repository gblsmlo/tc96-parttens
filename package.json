{
  "name": "tc96-parttens-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "boundaries:check": "bun scripts/check-boundaries.ts",
    "check:coss": "bun scripts/check-coss.ts",
    "sync:coss": "bun scripts/sync-coss.ts",
    "typecheck": "tsc --noEmit",
    "test:ui": "bun test --isolate packages/elements/src packages/utils/src",
    "test:patterns": "bun scripts/test-patterns.ts",
    "test:registry": "bun test --isolate packages/registry/src",
    "test": "bun run test:ui && bun run test:boundaries && bun run test:patterns && bun run test:registry",
    "build:registry": "bun packages/registry/src/build-registry.ts",
    "build": "bun run build:registry",
    "storybook": "bun run --cwd apps/storybook dev",
    "storybook:test": "bun run --cwd apps/storybook test",
    "storybook:build": "bun run --cwd apps/storybook build",
    "docs:build": "bun run --cwd apps/docs build",
    "docs:dev": "bun run --cwd apps/docs dev",
    "lint:ci": "biome check scripts packages/registry/src",
    "check": "bun run check:coss && bun run boundaries:check && bun run typecheck && bun run test && bun run build && bun run verify:public-api && bun run storybook:test && bun run storybook:build && bun run docs:build",
    "release:check": "bun run check && bun run test:consumer:registry && bun run test:consumer:ssr && bun run bench:views && bun run pack:check",
    "verify:public-api": "bun scripts/verify-public-api.ts",
    "test:consumer:registry": "bun scripts/test-consumer-registry.ts",
    "test:consumer:ssr": "bun scripts/test-consumer-ssr.ts",
    "bench:views": "bun scripts/bench-views.ts",
    "pack:check": "bun scripts/pack-check.ts",
    "test:boundaries": "bun test --isolate scripts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.3.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "@testing-library/react": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "6.0.3",
    "esbuild": "0.25.10",
    "@biomejs/biome": "2.3.4",
    "shadcn": "4.21.0",
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.28.0",
    "@daypicker/react": "10.0.2",
    "react-phone-number-input": "3.4.18",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@base-ui/react": "1.8.0"
  }
}
