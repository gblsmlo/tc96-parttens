{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@acme/ui": ["./packages/ui/src"],
      "@acme/ui/*": ["./packages/ui/src/*"],
      "@acme/elements": ["./packages/elements/src"],
      "@acme/elements/*": ["./packages/elements/src/*"],
      "@acme/helpers": ["./packages/helpers/src"],
      "@acme/helpers/*": ["./packages/helpers/src/*"],
      "@acme/patterns": ["./packages/organisms/src"],
      "@acme/patterns/*": ["./packages/organisms/src/*"]
    }
  },
  "include": ["src", "packages"]
}
